# ============================================================
# CHATTY NEMOTRON - CONFIGURARE CHEI API
# ============================================================
# Copiază acest fișier în .env și completează cheile tale.
# NU încărca fișierul .env pe GitHub!

# NVIDIA NIM (obligatoriu pentru majoritatea modelelor)
# Obține de la: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (opțional)
# Obține de la: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Groq (opțional)
# Obține de la: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
